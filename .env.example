# Copy this to .env for local testing (vercel dev), and add the same three
# values as Environment Variables in your Vercel project settings.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Any password you choose — this is what unlocks admin.html
ADMIN_KEY=choose-a-password-here
